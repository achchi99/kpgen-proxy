[Unit]
Description=kpgen-proxy monitoring: /classify (haqiqiy Anthropic ulanishini tekshiradi)
After=network-online.target kpgen-proxy.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/kpgen-monitor-secrets.env
ExecStart=/usr/bin/python3 /opt/kpgen-proxy-monitor/check_proxy.py classify
TimeoutStartSec=300
