# Bu fayl serverda /etc/kpgen-secrets.env sifatida joylashadi.
# Huquq: root:root, chmod 600 — faqat root va servis foydalanuvchisi o'qiy oladi.
# Haqiqiy kalitni bu repo/fayl ichiga HECH QACHON yozmang.

ANTHROPIC_API_KEY=sk-ant-...

# /loyiha_tavsiya (A8a) — ixtiyoriy, sukut qiymatlari yetarli:
# KPGEN_TAVSIYA_MODEL=claude-sonnet-5
# KPGEN_TAVSIYA_TIMEOUT_MATN=25
# KPGEN_TAVSIYA_TIMEOUT_RASM=50
# KPGEN_TAVSIYA_MAX_RASM_BAYT=2097152
# KPGEN_TAVSIYA_MAX_RASM_TOMON=2000
